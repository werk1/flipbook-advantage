# ── Production Secret Management ─────────────────────────────────────────
# ── App ──────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://mongo:27017/flipbook-advantage?replicaSet=rs0&directConnection=true
# Host-only Docker dev ports. Container traffic continues to use mongo:27017.
MONGO_PORT=27018
MONGO_EXPRESS_PORT=8082
PAYLOAD_SECRET=518fddc482be82d578d33f052714642a953be779cb141d345ce66cb39b699594
# Payload media storage (outside public/). Empty = <cwd>/media, i.e. the ./media volume.
MEDIA_STORAGE_ROOT=

NEXT_PUBLIC_SERVER_URL=http://localhost:3601
NEXT_PUBLIC_SCROLL_DEBUG=false

# Optional Umami analytics. Set to the site ID from umami.werk1.at;
# empty disables tracking.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional Umami heatmap/session recording (recorder.js, same site ID).
# Records sessions: check consent/privacy before enabling. Needs a rebuild.
NEXT_PUBLIC_UMAMI_HEATMAP=false

# Optional server-only Google Fonts catalog/import integration.
APP_FONTS_GOOGLE_API_KEY=

# Port auf dem der Container nach außen erreichbar ist
APP_PORT=3601
