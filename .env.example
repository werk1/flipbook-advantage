# ── Production Secret Management (Infisical) ─────────────────────────────────────────
# In production, secrets are loaded from Infisical (self-hosted).
# Only INFISICAL_TOKEN, INFISICAL_API_URL and INFISICAL_PROJECT_ID remain as
# plaintext on the server.
# All other secrets below are DEV-ONLY and must not be used in production.
# See docs/deployment/SECRETS_PROD.md for the production secret setup.
INFISICAL_TOKEN=
INFISICAL_API_URL=https://infisical.werk1.internal
# Infisical Project ID (kein Secret — aus Infisical Project Settings kopieren)
INFISICAL_PROJECT_ID=

# ── App ──────────────────────────────────────────────────────────────────────
# [Infisical in prod] MONGODB_URI
# Dev: no auth. Prod: mongodb://APP_USER:PASS@mongo:27017/flipbook-advantage?replicaSet=rs0
# App-DB-User muss in Mongo erstellt werden (siehe SECRETS_PROD.md).
MONGODB_URI=mongodb://mongo:27017/flipbook-advantage
# Host-only Docker dev ports. Container traffic continues to use mongo:27017.
MONGO_PORT=27018
MONGO_EXPRESS_PORT=8082
# [Infisical in prod] MONGO_INITDB_ROOT_USERNAME (nur bei leerem mongo-data für Init)
# [Infisical in prod] MONGO_INITDB_ROOT_PASSWORD
# [Infisical in prod] MONGO_KEYFILE_B64 (Replica-Set-Keyfile, siehe SECRETS_PROD.md)
# Dev: nicht benötigt. Prod: in Infisical, nicht in .env.
# [Infisical in prod] PAYLOAD_SECRET
PAYLOAD_SECRET=c4e01ee0359bff391c89b1c18698d8c44632b80babb6f6a02230b3f7363c80a2
# Payload media storage (outside public/). Empty = <cwd>/media, i.e. the ./media volume.
MEDIA_STORAGE_ROOT=

NEXT_PUBLIC_SERVER_URL=http://localhost:3601
NEXT_PUBLIC_SCROLL_DEBUG=false

# [Infisical in prod] APP_FONTS_GOOGLE_API_KEY
# Optional server-only Google Fonts catalog/import integration.
APP_FONTS_GOOGLE_API_KEY=

# Port auf dem der Container nach außen erreichbar ist
APP_PORT=3601
