FROM mongo:7

# Install Infisical CLI for production secret loading.
# The entrypoint in docker-compose.yml wraps mongo with `infisical run`.
# Mongo:7 is Ubuntu-based without Node.js, so we download the .deb directly.
ARG INFISICAL_CLI_VERSION=v0.43.114
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    curl -sSL -o /tmp/infisical.deb \
      "https://github.com/Infisical/cli/releases/download/${INFISICAL_CLI_VERSION}/infisical_0.43.114_linux_amd64.deb" && \
    dpkg -i /tmp/infisical.deb && \
    rm /tmp/infisical.deb && \
    apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# The replica set keyfile is NOT baked into the image: a build-time keyfile is
# identical for every deployment of the same image tag and readable by anyone
# with registry pull access. mongo-keyfile-entrypoint.sh writes it at container
# start from the runtime secret MONGO_KEYFILE_B64 (delivered by `infisical run`).
# The scripts are inlined (COPY heredoc, BuildKit) so this stays a single-file
# build context for the autodeploy scripts.
COPY --chmod=755 <<'EOF' /usr/local/bin/mongo-keyfile-entrypoint.sh
#!/bin/sh
# Materializes the MongoDB replica-set internal-auth keyfile from
# MONGO_KEYFILE_B64, then hands over to the stock docker-entrypoint.sh.
# MongoDB keyfiles store the base64 text itself (not decoded binary).
set -eu

if [ -z "${MONGO_KEYFILE_B64:-}" ]; then
  echo "mongo-keyfile-entrypoint: MONGO_KEYFILE_B64 is required (see docs/deployment/SECRETS_PROD.md)" >&2
  exit 1
fi

printf '%s' "$MONGO_KEYFILE_B64" > /etc/mongo-keyfile
chmod 400 /etc/mongo-keyfile
chown 999:999 /etc/mongo-keyfile

exec docker-entrypoint.sh "$@"
EOF

# One-shot, idempotent replica set initialisation. Run by the `mongo-init`
# compose service (also through `infisical run`, so the root credentials are in
# its environment). Safe to run on every deploy: it does nothing once the
# replica set exists.
COPY --chmod=755 <<'EOF' /usr/local/bin/mongo-replset-init.sh
#!/bin/sh
set -eu

MONGO_HOST="${MONGO_HOST:-mongo}"
MONGO_PORT="${MONGO_PORT:-27017}"
REPLSET_NAME="${MONGO_REPLSET_NAME:-rs0}"
MEMBER="${MONGO_HOST}:${MONGO_PORT}"
WAIT_SECONDS="${MONGO_INIT_WAIT_SECONDS:-120}"

waited=0
until mongosh --quiet --host "$MEMBER" --eval 'db.hello().ok' >/dev/null 2>&1; do
  if [ "$waited" -ge "$WAIT_SECONDS" ]; then
    echo "mongo-replset-init: $MEMBER not reachable after ${WAIT_SECONDS}s" >&2
    exit 1
  fi
  sleep 2
  waited=$((waited + 2))
done

# db.hello() needs no authentication and only reports setName once a replica
# set config exists.
if mongosh --quiet --host "$MEMBER" --eval 'quit(db.hello().setName ? 0 : 1)' >/dev/null 2>&1; then
  echo "mongo-replset-init: replica set already initialised"
  exit 0
fi

if [ -z "${MONGO_INITDB_ROOT_USERNAME:-}" ] || [ -z "${MONGO_INITDB_ROOT_PASSWORD:-}" ]; then
  echo "mongo-replset-init: MONGO_INITDB_ROOT_USERNAME and MONGO_INITDB_ROOT_PASSWORD are required (see docs/deployment/SECRETS_PROD.md)" >&2
  exit 1
fi

MEMBER="$MEMBER" REPLSET_NAME="$REPLSET_NAME" mongosh --quiet --host "$MEMBER" \
  --username "$MONGO_INITDB_ROOT_USERNAME" --password "$MONGO_INITDB_ROOT_PASSWORD" \
  --authenticationDatabase admin --eval '
    try {
      rs.initiate({ _id: process.env.REPLSET_NAME, members: [{ _id: 0, host: process.env.MEMBER }] });
    } catch (e) {
      if (e.codeName !== "AlreadyInitialized") throw e;
    }
  '
echo "mongo-replset-init: replica set $REPLSET_NAME initialised"
EOF
